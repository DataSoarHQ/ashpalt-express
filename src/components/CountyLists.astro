---
// Every town, grouped by county. County names are H3s (relevant entities, per the SEO review).
import { counties, href } from '../data/site';
const { counts = false } = Astro.props;
const [first, ...rest] = counties;
const n = (k: number) => `${k} ${k === 1 ? 'community' : 'communities'} served`;
---
<div class="counties">
  <div class="county">
    <h3>{first.name} County</h3>
    {counts && <p class="county__count">{n(first.towns.length)}</p>}
    <ul>{first.towns.map((t) => <li data-town={t.name}><a href={href(t.slug)}>{t.name}</a></li>)}</ul>
  </div>
  {[rest.slice(0, 2), rest.slice(2)].map((col) => (
    <div class="county__rest">
      {col.map((c) => (
        <div class="county county--small">
          <h3>{c.name} County</h3>
          {counts && <p class="county__count">{n(c.towns.length)}</p>}
          <ul>{c.towns.map((t) => <li data-town={t.name}><a href={href(t.slug)}>{t.name}</a></li>)}</ul>
        </div>
      ))}
    </div>
  ))}
</div>
